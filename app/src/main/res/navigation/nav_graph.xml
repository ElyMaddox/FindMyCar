<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.findmycar.login.LoginFragment"
        android:label="@string/login_title"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.findmycar.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_homeFragment_to_aiAssistantFragment"
            app:destination="@id/aiAssistantFragment" />
        <action
            android:id="@+id/action_homeFragment_to_carDetailsFragment"
            app:destination="@id/carDetailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_interactiveSearchFragment"
            app:destination="@id/interactiveSearchFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.findmycar.profile.ProfileFragment"
        android:label="@string/profile_fragment_label"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/aiAssistantFragment"
        android:name="com.example.findmycar.aiassistant.AIAssistantFragment"
        android:label="AI Assistant"
        tools:layout="@layout/fragment_ai_assistant">
        <action
            android:id="@+id/action_aiAssistantFragment_to_carDetailsFragment"
            app:destination="@id/carDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/carDetailsFragment"
        android:name="com.example.findmycar.cardetails.CarDetailsFragment"
        android:label="Car Details"
        tools:layout="@layout/fragment_car_details">
        <argument
            android:name="carId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/interactiveSearchFragment"
        android:name="com.example.findmycar.interactivesearch.InteractiveSearchFragment"
        android:label="Interactive Search"
        tools:layout="@layout/fragment_interactive_search">
        <action
            android:id="@+id/action_interactiveSearchFragment_to_carDetailsFragment"
            app:destination="@id/carDetailsFragment" />
    </fragment>

</navigation>